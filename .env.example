# Remnawave API base URL, for example: https://remnawave.example
REMNAWAVE_API_URL=

# Remnawave API bearer token
REMNAWAVE_API_TOKEN=

# Optional A2 secondary username suffix
REMNAWAVE_SECONDARY_SUFFIX=_addsub

# Optional upstream timeout in seconds
REMNAWAVE_TIMEOUT_SECONDS=10

# Optional maximum rendered subscription body size in bytes (default: 8 MiB)
REMNAWAVE_MAX_SUBSCRIPTION_BYTES=8388608

# Optional label prepended to every secondary node/name
REMNAWAVE_SECONDARY_LABEL=

# Rezeis admin base URL used only to validate the current admin bearer token
# and resolve the two selected subscriptions' configUrl values.
REZEIS_BASE_URL=

# Persistent data directory for operator-selected merge pairs
MERGE_DATA_DIR=/var/lib/remnawave-subscription-merge
