# Адрес API Remnawave
REMNAWAVE_API_URL=

# Bearer-токен API Remnawave
REMNAWAVE_API_TOKEN=

# Суффикс личной secondary-подписки в A2 режиме
REMNAWAVE_SECONDARY_SUFFIX=_addsub

# Таймаут upstream-запросов, секунд
REMNAWAVE_TIMEOUT_SECONDS=10

# Максимальный размер subscription-ответа, байт
REMNAWAVE_MAX_SUBSCRIPTION_BYTES=8388608

# Необязательная метка для secondary узлов
REMNAWAVE_SECONDARY_LABEL=

# URL панели Rezeis для ручного режима
REZEIS_BASE_URL=

# Постоянный каталог данных ручных пар
MERGE_DATA_DIR=/var/lib/remnawave-subscription-merge
